# Supabase loyihangiz sozlamalaridan (Project Settings > API) oling
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DIQQAT: bu maxfiy kalit — faqat serverda ishlatiladi (API route'larda),
# hech qachon brauzerga (client komponentga) chiqarmang va GitHub'ga
# committ qilmang (.env* fayllar .gitignore'da).
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telefon raqamlar shu domen bilan sun'iy emailga aylantiriladi
# (foydalanuvchi buni ko'rmaydi, faqat ichki auth mexanizmi uchun).
# NEXT_PUBLIC_ prefiksi shart — bu qiymat login formada (brauzerda) ham ishlatiladi.
NEXT_PUBLIC_AUTH_PHONE_DOMAIN=xavfsizimtihon.local
